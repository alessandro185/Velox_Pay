# =====================================================================
# VeloxPay - Variáveis de Ambiente
# =====================================================================

# Banco de dados:
# Por padrão utiliza SQLite local sem necessidade de nenhuma instalação externa:
DATABASE_URL=sqlite:///./veloxpay.db

# Para conectar ao MySQL em produção ou Docker, descomente a linha abaixo:
# DATABASE_URL=mysql+pymysql://root:rootpassword@127.0.0.1:3306/veloxpay

# Configurações do Servidor Uvicorn / FastAPI
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
